# Required. Obtain from @BotFather. Never commit a real value.
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Deny-by-default authorization. Numeric IDs only; comma-separated.
# Users authorize ingress actors. Chats authorize ingress AND outbound targets.
# If both are populated, an incoming event must satisfy both lists.
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# This escape hatch opens ingress only; outbound still requires an explicit chat ID.
TELEGRAM_ALLOW_ALL=false

# Fastest and safest local Codex profile.
BRIDGE_TRANSPORT=stdio
TELEGRAM_INGRESS_MODE=polling
BRIDGE_DATABASE_PATH=data/bridge.sqlite3
SQLITE_SYNCHRONOUS=FULL
BRIDGE_MAX_QUEUE_EVENTS=100000
BRIDGE_MAX_CLAIM_EVENTS=50
BRIDGE_MAX_WAIT_SECONDS=30
BRIDGE_RETENTION_DAYS=30

# HTTP/webhook profile only. Generate independent random values.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_AUTH_TOKEN=
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Minimize data accepted from Telegram.
TELEGRAM_ALLOWED_UPDATES=message,edited_message,callback_query
BRIDGE_MAX_UPDATE_BYTES=1048576

# Network tuning.
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_POLL_TIMEOUT=50
LOG_LEVEL=INFO
